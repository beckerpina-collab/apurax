# ============================================================================
# APURAX — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env.
# ============================================================================

# --- Banco -------------------------------------------------------------------
# QUICKSTART (dev rápido): usa o superusuário do Postgres. ATENÇÃO: superusuário
# IGNORA Row-Level Security — isolamento por tenant NÃO é enforçado neste modo.
# Bom para desenvolvimento single-tenant; veja o README para ligar a RLS de verdade.
DATABASE_URL="postgresql://postgres:apurax_dev@localhost:5432/apurax?schema=public"

# ISOLAMENTO REAL (RLS): aponte para o papel NÃO-superusuário criado pelo
# init-db.sql. Aí sim a RLS é aplicada (políticas em prisma/rls.sql).
# DATABASE_URL="postgresql://apurax_app:apurax_dev@localhost:5432/apurax?schema=public"

# --- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL pública (produção: https://www.apurax.com.br)
APURAX_BASE_URL="http://localhost:3000"
# Origens permitidas no CORS (lista separada por vírgula). Vazio = usa o padrão
# (apurax.com.br, www.apurax.com.br e localhost de dev).
APURAX_CORS_ORIGINS=""

# --- JWT ---------------------------------------------------------------------
JWT_SECRET="troque-isto-por-um-segredo-forte-em-producao"
JWT_ACCESS_TTL="15m"
# Refresh token (renovação automática do access). O segredo é opcional: se não
# definido, é derivado do JWT_SECRET. TTL padrão 30 dias.
# JWT_REFRESH_SECRET=""
JWT_REFRESH_TTL="30d"

# --- Storage (S3/MinIO) — usado nas próximas etapas (DFe/GED) -----------------
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="apurax"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"

# --- Redis (BullMQ) — usado nas próximas etapas (parse assíncrono) ------------
REDIS_HOST="localhost"
REDIS_PORT=6379

# --- IA (Anthropic) — Etapa 7: classificação (Haiku) e agente explicador (Opus)
# A IA NÃO calcula imposto; usa tool-use para chamar o motor determinístico.
ANTHROPIC_API_KEY=""

# --- Distribuição DFe + custódia A1 (Etapa 8) --------------------------------
# Master key da custódia do certificado (envelope encryption). Em produção,
# trocar por KMS (AWS/GCP/Azure). Qualquer segredo forte; vira 32 bytes via sha256.
APURAX_KMS_MASTER_KEY=""
# Ambiente da SEFAZ: 1=produção, 2=homologação (padrão 2 por segurança).
APURAX_DFE_TPAMB=2

# --- Bling (integração de saídas → imposto a pagar) --------------------------
# App DEDICADO da Apurax em developer.bling.com.br/aplicativos (escopos: Notas
# Fiscais + Produtos). access_token ~6h, refresh ~30d (rotaciona).
# A redirect_uri cadastrada no Bling DEVE ser IDÊNTICA à BLING_REDIRECT_URI aqui
# e à URL real do callback. O backend mora atrás de /api → o callback é
# /api/bling/callback.
#   Produção: https://www.apurax.com.br/api/bling/callback
#   Dev:      http://localhost:3000/api/bling/callback
BLING_CLIENT_ID=""
BLING_CLIENT_SECRET=""
BLING_REDIRECT_URI="https://www.apurax.com.br/api/bling/callback"
# Para onde o callback redireciona o navegador depois de conectar (front).
#   Produção: https://www.apurax.com.br   |   Dev: http://localhost:5173
APP_URL="https://www.apurax.com.br"

# --- Reforma CBS/IBS (Etapa 9) — alíquota de referência p/ projetar o "delta" --
# Estimativa Fazenda (~26,5% total). Parametrizável/versionável; não fixada por resolução.
APURAX_ALIQ_REF_CBS=0.088
APURAX_ALIQ_REF_IBS=0.177
