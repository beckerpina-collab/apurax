# URL da API NestJS do Apurax. O backend mora atrás de /api.
#   Produção: "/api" (mesmo domínio www.apurax.com.br, via rewrite Firebase→Cloud Run; sem CORS)
#   Dev:      "http://localhost:3000/api"
VITE_API_URL="http://localhost:3000/api"
# Modo demo: "true" usa dados de exemplo no próprio frontend (sem backend).
# Defina "false" para falar com a API real (VITE_API_URL).
VITE_DEMO="true"
